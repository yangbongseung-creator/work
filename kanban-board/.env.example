# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 GitHub에 올라가지 않습니다)
#   cp .env.example .env

# PostgreSQL 연결 주소:  postgres://사용자:비밀번호@주소:포트/DB이름
# 같은 서버에 설치했다면 주소는 127.0.0.1, 포트는 5432 입니다.
DATABASE_URL=postgres://kanban:여기에_비밀번호@127.0.0.1:5432/kanban

# (선택) 한 DB를 나눠 쓸 때 표를 만들 스키마 이름. 이 줄을 # 그대로 두면 public
# DATABASE_SCHEMA=

# (선택) 첨부 파일 저장 폴더. 이 줄을 # 그대로 두면 앱 폴더 아래 data/uploads
# KANBAN_UPLOADS=/home/kanban-board/data/uploads

# (선택) SSH 터널로 접속할 때 내 PC 쪽 포트를 3000이 아닌 다른 번호로 쓰려면, 맨 앞 #을 지우고 그 번호를 쉼표로 추가
# KANBAN_ALLOWED_PORTS=3000,8080
